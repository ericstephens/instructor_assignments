# ── Database ──────────────────────────────────────────────────────────────────
# Main application database (used by API and Alembic)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/instructor_db

# Test database (used by pytest in src/db/tests and src/api/tests)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/instructor_test_db

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (browser → API)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL of the FastAPI server (used by src/frontend/src/api/client.js)
VITE_API_URL=http://localhost:8000

# ── Quick start ───────────────────────────────────────────────────────────────
# 1. Copy this file:          cp .env.example .env
# 2. Start postgres:          ./manage.sh db:start
# 3. Run migrations:          ./manage.sh db:migrate
# 4. Start API:               ./manage.sh api:start
# 5. Start frontend:          ./manage.sh fe:start
# 6. Run all tests:           ./manage.sh test
